# The single declared source for which GCP project and region this repo
# deploys to. Read natively by the Makefile (`include`), Terraform (as
# TF_VAR_*), GitHub Actions, and the build/deploy-time Python entry points
# via will_it_rain_shared.gcp.
#
# Deliberately not `.env`: that file is gitignored and holds the private
# location config (see .env-example). These values are not secret, and they
# must be committed, reviewable, and present in a fresh clone.
#
# Keep this KEY=value only — CI feeds it straight into the job environment.
PROJECT_ID=will-it-rain-496215
REGION=europe-west2

# Firebase Hosting site — the public hostname, https://<id>.web.app. Declared
# separately from PROJECT_ID so the URL doesn't move when the project does.
# frontend/firebase.json must carry the same value; JSON can't interpolate.
HOSTING_SITE_ID=will-it-rain-496215
